# File: .env.example
# Version: 2.0.0
# Copy this file to .env (which is git-ignored) and adjust paths for your machine.
# Forward slashes (/) and ~ work automatically on both Linux and Windows.

SHR_OFFICIAL_DIR=../smallhotelroom.github.io/src/contents/songs
SHR_CURATED_DIR=~/your-chords-folder
SHR_CRAWLER_DIR=/path/to/datasets/music/myDataset
SHR_CRAWLER_CACHE_DIR=/path/to/datasets/music/myDataset-cache
SHR_ZK_SUBDIR=zk_folder_name
SHR_LK_SUBDIR=lk_folder_name
