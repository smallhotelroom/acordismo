# File: .env.example
# Version: 1.0.0
# Copy this file to .env (which is git-ignored) and adjust paths for your machine.
# Forward slashes (/) and ~ work automatically on both Linux and Windows.

ACORDISMO_OFFICIAL_DIR=../smallhotelroom.github.io/src/contents/songs
ACORDISMO_CURATED_DIR=~/your-chords-folder
ACORDISMO_CRAWLER_DIR=/path/to/datasets/music/myDataset
ACORDISMO_CRAWLER_CACHE_DIR=/path/to/datasets/music/myDataset-cache
ACORDISMO_ZK_SUBDIR=zk_folder_name
ACORDISMO_LK_SUBDIR=lk_folder_name
