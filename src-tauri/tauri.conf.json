{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Small Hotel Room",
  "version": "0.2.0",
  "identifier": "com.smallhotelroom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Small Hotel Room (App)",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Small Hotel Room Songbook, Metronome & Tuner",
    "longDescription": "Small Hotel Room (App) is an offline songbook, chord & arpeggio sequencer, polyrhythm metronome, and reference ear tuner.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
