{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acordismo",
  "version": "0.1.0",
  "identifier": "com.smallhotelroom.acordismo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Acordismo",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Offline Songbook & Chord Transposer",
    "longDescription": "Acordismo is an offline songbook, chord sheet viewer, and harmonic transposer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
